{
  "name": "musicology",
  "version": "0.0.0",
  "private": true,
  "description": "A local-first personal music-history laboratory",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=9 <10"
  },
  "packageManager": "pnpm@9.0.0",
  "volta": {
    "node": "24.15.0",
    "pnpm": "9.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "analyze:volume": "node --env-file-if-exists=.env src/cli/analyze-volume.ts",
    "analyze:artist-eras": "node --env-file-if-exists=.env src/cli/analyze-artist-eras.ts",
    "analyze:abandonment": "node --env-file-if-exists=.env src/cli/analyze-abandonment.ts",
    "analyze:rediscovery": "node --env-file-if-exists=.env src/cli/analyze-rediscovery.ts",
    "benchmark:analytics": "node --env-file-if-exists=.env src/cli/benchmark-analytics.ts",
    "db:migrate": "node --env-file-if-exists=.env src/cli/db.ts migrate",
    "db:status": "node --env-file-if-exists=.env src/cli/db.ts status",
    "enrich:genres": "node --env-file-if-exists=.env src/cli/enrich-genres.ts",
    "genre:taxonomy": "node --env-file-if-exists=.env src/cli/genre-taxonomy.ts",
    "export:analytics": "node --env-file-if-exists=.env src/cli/export-analytics.ts",
    "export:reconciliation-calibration": "node --env-file-if-exists=.env src/cli/export-reconciliation-calibration.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "import:lastfm-export": "node --env-file-if-exists=.env src/cli/import-lastfm-export.ts",
    "import:spotify": "node --env-file-if-exists=.env src/cli/import-spotify.ts",
    "publication:activate": "node --env-file-if-exists=.env src/cli/publication.ts activate",
    "publication:approve": "node --env-file-if-exists=.env src/cli/publication.ts approve",
    "publication:build": "pnpm run site:build && pnpm run site:verify",
    "publication:generate": "node --env-file-if-exists=.env src/cli/publication.ts generate",
    "publication:review": "node --env-file-if-exists=.env src/cli/publication.ts review",
    "lint": "biome lint .",
    "quality": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run site:typecheck && pnpm run test && pnpm run site:test && pnpm run build && pnpm run site:build:fixture && pnpm run site:verify && pnpm run site:build:empty && pnpm run site:verify",
    "report:coverage": "node --env-file-if-exists=.env src/cli/report-coverage.ts",
    "reconcile": "node --env-file-if-exists=.env src/cli/reconcile.ts",
    "review:decisions": "node --env-file-if-exists=.env src/cli/review-decisions.ts",
    "site:build": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs build --config site/astro.config.ts",
    "site:build:empty": "MUSICOLOGY_SITE_FIXTURE=empty node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs build --config site/astro.config.ts",
    "site:build:fixture": "MUSICOLOGY_SITE_FIXTURE=full node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs build --config site/astro.config.ts",
    "site:dev": "MUSICOLOGY_SITE_FIXTURE=full node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev --config site/astro.config.ts",
    "site:serve": "node site/scripts/serve-built-site.ts",
    "site:test": "vitest run --config site/vitest.config.ts",
    "site:test:browser": "playwright test --config site/playwright.config.ts",
    "site:typecheck": "tsc --project site/tsconfig.json --noEmit",
    "site:verify": "node site/scripts/verify-built-site.ts",
    "site:verify:deployed": "node --env-file-if-exists=.env site/scripts/verify-deployed-site.ts",
    "sync:lastfm": "node --env-file-if-exists=.env src/cli/sync-lastfm.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "validate": "node --env-file-if-exists=.env src/cli/validate.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.4",
    "@playwright/test": "1.62.1",
    "@testing-library/preact": "3.2.4",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@astrojs/preact": "6.0.2",
    "@observablehq/plot": "0.6.17",
    "astro": "7.2.0",
    "better-sqlite3": "12.11.1",
    "preact": "10.29.8"
  }
}
