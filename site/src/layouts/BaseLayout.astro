---
import SiteNavigation from "../components/SiteNavigation.astro";
import "../styles/global.css";

interface Props {
  readonly canonicalPath: string;
  readonly currentPath: string;
  readonly description: string;
  readonly title: string;
}

const { canonicalPath, currentPath, description, title } = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url.origin);
const pageTitle = title === "Musicology" ? title : `${title} — Musicology`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ece3d2" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Musicology" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="page-frame">
      <header class="site-header">
        <SiteNavigation currentPath={currentPath} />
      </header>
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer">
        <p><strong>Musicology</strong> reads one personal archive as evidence, not as a verdict.</p>
        <p>
          <a href="/methodology/#privacy">Publication & privacy</a>
          <span aria-hidden="true">·</span>
          <a href="/methodology/#definitions">Definitions</a>
        </p>
      </footer>
    </div>
  </body>
</html>
