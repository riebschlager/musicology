---
import DisclosurePanel from "../components/DisclosurePanel.astro";
import NarrativeSection from "../components/NarrativeSection.astro";
import PageIntro from "../components/PageIntro.astro";
import StatePanel from "../components/StatePanel.astro";
import { ExplorerFilter } from "../islands/ExplorerFilter.tsx";
import { loadSiteSnapshot } from "../adapters/public-snapshot.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildAnalyticalDisclosure, parseExplorerState } from "../view-models/site.ts";

const snapshot = loadSiteSnapshot();
const disclosure = buildAnalyticalDisclosure(snapshot);
const state = parseExplorerState(Astro.url.searchParams);
const canonicalPath = `/explore/${state.canonicalSearch}`;
---

<BaseLayout
  canonicalPath={canonicalPath}
  currentPath="/explore/"
  description="Inspect bounded, URL-addressable states over the approved public listening snapshot."
  title="Explore"
>
  <PageIntro
    chapter="Workbench · Bounded views"
    title="Change the frame, not the evidence boundary."
    dek="Every control selects only rows already present in the approved public snapshot. The default answer and its limitations remain readable without JavaScript."
  />

  <NarrativeSection
    id="explorer-state"
    index="01"
    eyebrow="Directly linkable state"
    title="A useful URL before hydration."
    summary="Native form controls submit an ordinary page request. Unsupported keys fall back visibly and never widen the public cohort."
  >
    <ExplorerFilter defaultState={state} client:load />
    <StatePanel
      kind={snapshot.history.data.periods.length === 0 ? "empty" : "loading"}
      headingLevel={3}
      heading={snapshot.history.data.periods.length === 0 ? "No approved aggregate matches" : "Default public aggregate ready"}
      message={snapshot.history.data.periods.length === 0
        ? "The chosen controls are preserved, but an evidence-free range is not described as zero listening."
        : "The static summary is available now. A later bounded island may coordinate the chart instantly without becoming the only route to the data."}
    />
  </NarrativeSection>

  <DisclosurePanel disclosure={disclosure} />
</BaseLayout>
