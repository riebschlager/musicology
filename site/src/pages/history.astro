---
import ChartFrame from "../components/ChartFrame.astro";
import DataTable from "../components/DataTable.astro";
import DisclosurePanel from "../components/DisclosurePanel.astro";
import NarrativeSection from "../components/NarrativeSection.astro";
import PageIntro from "../components/PageIntro.astro";
import StatePanel from "../components/StatePanel.astro";
import { loadSiteSnapshot } from "../adapters/public-snapshot.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildAnalyticalDisclosure, formatNumber, formatPercent } from "../view-models/site.ts";

const snapshot = loadSiteSnapshot();
const disclosure = buildAnalyticalDisclosure(snapshot);
const hasHistory = snapshot.history.data.periods.length > 0;
---

<BaseLayout
  canonicalPath="/history/"
  currentPath="/history/"
  description="See where the listening evidence comes from, where it is thin, and which metrics cover the full retained history."
  title="History & coverage"
>
  <PageIntro
    chapter="Field notes · Coverage"
    title="Where the evidence speaks—and where it goes quiet."
    dek="A gap in one source is not an absence of listening. Coverage belongs beside the history before any rise or fall becomes a claim."
  />

  <NarrativeSection
    id="history-question"
    index="01"
    eyebrow="The public question"
    title="What can the retained record honestly support?"
    summary={`${formatNumber(snapshot.manifest.coverage.canonicalEventCount)} canonical events are represented in this reviewed snapshot; source evidence and duration coverage remain separately labeled.`}
  >
    {hasHistory ? (
      <>
        <ChartFrame
          title="Canonical play count with source context"
          description="The route shell binds the future visual layer to this visible definition, summary, disclosure, and equivalent table contract."
          tableId="history-contract-table"
        >
          <div class="chart-placeholder">
            <p>
              Full-history play count and source coverage will share one reading sequence. Color,
              position, and hover will never be the only ways to identify a gap or value.
            </p>
          </div>
        </ChartFrame>
        <DataTable
          id="history-contract-table"
          caption="Current public history scope"
          headers={["Measure", "Reviewed value", "Scope"]}
          rows={[
            [
              "Canonical play count",
              formatNumber(snapshot.manifest.coverage.canonicalEventCount),
              "Full retained history",
            ],
            [
              "Spotify duration coverage",
              formatNumber(snapshot.manifest.coverage.spotifyDurationEventCount),
              "Spotify-backed events only",
            ],
            [
              "Unresolved proportion",
              formatPercent(snapshot.manifest.coverage.unresolvedRate),
              "Included in canonical play count",
            ],
          ]}
        />
      </>
    ) : (
      <StatePanel
        kind="empty"
        headingLevel={3}
        heading="No reviewed history rows"
        message="No zero timeline is invented. Coverage definitions and methodology remain available."
      />
    )}
  </NarrativeSection>

  <DisclosurePanel disclosure={disclosure} />
</BaseLayout>
